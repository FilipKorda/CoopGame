--- !u!114 &573950422
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 573950419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=110><b>CREDITS</b></size>\n\n<size=64>[ TU WPISZ NAZW\u0118 SWOJEJ
    GRY ]</size>\n\n\n\n<size=58><b><color=#E8C25A>ROZDZIA\u0141 I: CZ\u0141OWIEK
    ORKESTRA</color></b></size>\n\n<size=32><color=#9DA8B5>AUTOR SEKWENCJI DNA GRY
    (czyli cz\u0142owiek od wszystkiego)</color></size>\n<size=42>Filip Korda</size>\n\n\n<size=44><b>ODPOWIEDZIALNI
    ZA KOD I JEGO ZAPIS</b></size>\n\n<size=32><color=#9DA8B5>\u0141atanie b\u0142\u0119d\xF3w
    o 3:00 rano</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Ignorowanie
    ostrze\u017Ce\u0144 w kompilatorze</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Modlitwy
    o brak crashy na premier\u0119</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Przekl\u0119te
    linijki kodu, kt\xF3rych nikt nie odwa\u017Cy si\u0119 dotkn\u0105\u0107</color></size>\n<size=42>Filip
    Korda</size>\n\n\n<size=44><b>OPIEKA GRAFICZNA I WIZUALNA</b></size>\n\n<size=32><color=#9DA8B5>Rysowanie
    pikseli / Poligon\xF3w</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Mru\u017Cenie
    oczu i udawanie, \u017Ce \u015Bwiat\u0142o dobrze wygl\u0105da</color></size>\n<size=42>Filip
    Korda</size>\n\n<size=32><color=#9DA8B5>Walka z animacjami, \u017Ceby posta\u0107
    nie wygl\u0105da\u0142a jak spagetti</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Bezcenne
    usuwanie niedzia\u0142aj\u0105cych tekstur tu\u017C przed snem</color></size>\n<size=42>Filip
    Korda</size>\n\n\n<size=44><b>IN\u017BYNIERIA D\u0179WI\u0118KU I ATMOSFERY</b></size>\n\n<size=32><color=#9DA8B5>Klikanie
    w mikrofon i szukanie darmowych efekt\xF3w</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Nucenie
    melodii pod nosem</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Odtwarzanie
    tego samego utworu przez 80 godzin pracy</color></size>\n<size=42>Filip Korda</size>\n\n<size=32><color=#9DA8B5>Paniczne
    poszukiwanie cichego pliku .wav</color></size>\n<size=42>Filip Korda</size>\n\n\n\n\n<size=58><b><color=#E8C25A>ROZDZIA\u0141
    II: ZAPLECZE LOGISTYCZNE I EMOCJONALNE</color></b></size>\n\n\n<size=44><b>DZIELNE
    WSPARCIE W NAJGORSZYCH CHWILACH</b></size>\n\n<size=32><color=#9DA8B5>Kawa, herbata
    i napoje energetyczne</color></size>\n<size=42>Zawsze w pogotowiu</size>\n\n<size=32><color=#9DA8B5>G\u0142\xF3wny
    Inspektor Klawiatury</color></size>\n<size=42>Kot \u201CTop Chips\u201D</size>\n\n<size=32><color=#9DA8B5>Wierny
    obserwator i kanapowiec</color></size>\n<size=42>Pies \u201CHop Cola\u201D</size>\n\n<size=32><color=#9DA8B5>Fotel
    przed biurkiem</color></size>\n<size=42>Za wytrzymanie tylu godzin bez rozpadni\u0119cia
    si\u0119</size>\n\n<size=32><color=#9DA8B5>Wyszukiwarka Google i Stack Overflow</color></size>\n<size=42>Za
    brak pyta\u0144, oceniania i gotowe rozwi\u0105zania</size>\n\n\n<size=44><b>TESTERZY
    ZDROWIA PSYCHICZNEGO (QA)</b></size>\n\n<size=32><color=#9DA8B5>Ci, kt\xF3rzy
    musieli s\u0142ucha\u0107 \u201Ezobacz co doda\u0142em!\u201D po raz 500</color></size>\n<size=42>Wiele
    wspania\u0142ych os\xF3b na Discordzie</size>\n\n<size=32><color=#9DA8B5>Osoby,
    kt\xF3re zagra\u0142y w wersj\u0119 pre-alpha i powiedzia\u0142y \u201Efajne,
    tylko ma\u0142o p\u0142ynne\u201D</color></size>\n<size=42>Rodzice, siostra i
    najlepsi znajomi</size>\n\n\n<size=44><b>DZIA\u0141 ZARZ\u0104DZANIA KRYZYSOWEGO</b></size>\n\n<size=32><color=#9DA8B5>Osoba,
    kt\xF3ra cudem nie porzuci\u0142a tego projektu w po\u0142owie</color></size>\n<size=42>Filip
    Korda</size>\n\n\n\n\n<size=58><b><color=#E8C25A>ROZDZIA\u0141 III: FINA\u0141</color></b></size>\n\n\n<size=44><b>SPECIAL
    THANKS / PODZI\u0118KOWANIA</b></size>\n\n<size=38><b>Dla Ciebie, drogi Graczu.</b></size>\n\n<size=38>Za
    to, \u017Ce po\u015Bwi\u0119ci\u0142e\u015B sw\xF3j czas, uruchomi\u0142e\u015B
    t\u0119 gr\u0119 i dotar\u0142e\u015B a\u017C do tego miejsca.</size>\n\n<size=38>Stworzenie
    tej produkcji w pojedynk\u0119 by\u0142o szalon\u0105 przygod\u0105, pe\u0142n\u0105
    zw\u0105tpie\u0144, ale to Twoja obecno\u015B\u0107 sprawia, \u017Ce ca\u0142y
    ten wysi\u0142ek mia\u0142 g\u0142\u0119boki sens.</size>\n\n<size=38><i>\u017Baden
    monitor czy myszka nie ucierpia\u0142 podczas produkcji tej gry. (Chocia\u017C
    klawiatura by\u0142a bardzo, bardzo blisko).</i></size>\n\n\n\n<size=34>\xA9
    [2026] [Filip Korda].</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
