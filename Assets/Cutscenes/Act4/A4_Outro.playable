  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Opiekun 1
  text: "Ale to by\u0142a bitwa... Str\xF3\u017Ce prawa, armia protagonisty i jeszcze
    ten statek!"
  speakerColor: {r: 0.45, g: 0.75, b: 1, a: 1}
--- !u!114 &4314901481304461090
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
