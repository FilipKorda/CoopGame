  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Opiekun 1
  text: "Nie ma co zwleka\u0107. Szybko zakradniemy si\u0119 do \u015Brodka..."
  speakerColor: {r: 0.45, g: 0.75, b: 1, a: 1}
--- !u!114 &4694454001502768521
