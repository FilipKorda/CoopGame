  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A7_to_A8
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A7_Start
  toScene: A8_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Ale\u017C to by\u0142a euforia!"
    seconds: 1.8
    voice: {fileID: 8300000, guid: 3a5fe8f3cffcf7c4698bbdc46495873a, type: 3}
  - text: "Ucieczka si\u0119 powiod\u0142a, przedmiot jest w ich r\u0119kach, a sukces
      w ko\u0144cu smakuje tak, jak powinien."
    seconds: 6.8
    voice: {fileID: 8300000, guid: 7e8477078b33e17428a60014d048daef, type: 3}
  - text: "No, prawie... bo jest jeden irytuj\u0105cy problem: nikt nie ma poj\u0119cia,
      jak to dzia\u0142a!"
    seconds: 5.5
    voice: {fileID: 8300000, guid: 9b45a58980aa6a641b11bafdbd0d4fd1, type: 3}
  - text: "Wygl\u0105da na to, \u017Ce nie maj\u0105 wyj\u015Bcia - musz\u0105 znowu
      wraca\u0107 do prezydenta wyspy po odpowiedzi."
    seconds: 6.3
    voice: {fileID: 8300000, guid: dfebbfd28c9cfb54dbd8f85e68678daa, type: 3}
