  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A6_to_A7
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A6_Start
  toScene: A7_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Nasi bohaterowie wreszcie ruszaj\u0105 w drog\u0119 po ten tajemniczy
      przedmiot!"
    seconds: 5.1
    voice: {fileID: 8300000, guid: d4303c134d04c88468ed8cbeeca9fab4, type: 3}
  - text: "Tym razem maj\u0105 mn\xF3stwo broni, wi\u0119ksze do\u015Bwiadczenie
      i zaj\u0105wszy \u015Bwietn\u0105 pozycj\u0119, wiedz\u0105, \u017Ce wr\xF3g
      ich nie zaskoczy."
    seconds: 7.7
    voice: {fileID: 8300000, guid: e3f37a2454e70ce46ba9159bb5363894, type: 3}
  - text: "Po wielu dniach lotu wprost do kryj\xF3wki wskazanej przez prezydenta,
      dolecieli wreszcie na miejsce."
    seconds: 6.2
    voice: {fileID: 8300000, guid: 05312d2a2682f444cb8b326f5f2d69e4, type: 3}
  - text: Gotowi na sto procent.
    seconds: 1.7
    voice: {fileID: 8300000, guid: b2e540ee9880d3244ad58a46c96e775e, type: 3}
