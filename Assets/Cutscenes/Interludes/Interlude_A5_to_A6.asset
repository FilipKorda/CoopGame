  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A5_to_A6
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A5_Start
  toScene: A6_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Prezydent wytropi\u0142 dla nas uciekaj\u0105cego wroga!"
    seconds: 3
    voice: {fileID: 8300000, guid: dcb61c11445db1349a25603e44cf6023, type: 3}
  - text: "Niestety, gdy ruszyli\u015Bmy w po\u015Bcig, pot\u0119\u017Cna burza znios\u0142a
      nas z kursu."
    seconds: 4.9
    voice: {fileID: 8300000, guid: 2824cf0528b5abe42a8dbce1f70ae567, type: 3}
  - text: "Nasza \u0142\xF3d\u017A roztrzaska\u0142a si\u0119, a my utkn\u0119li\u015Bmy
      na bezludnej wyspie."
    seconds: 4.7
    voice: {fileID: 8300000, guid: 015931d06af34a14b88692f08c5e3cd9, type: 3}
  - text: "Po siedmiu dniach pe\u0142nych walki o przetrwanie, znik\u0105d pojawi\u0142a
      si\u0119 pomoc i zabra\u0142a nas w bezpieczne miejsce."
    seconds: 6.9
    voice: {fileID: 8300000, guid: 47d43b4d61d7ea744887cab1c6a070a1, type: 3}
