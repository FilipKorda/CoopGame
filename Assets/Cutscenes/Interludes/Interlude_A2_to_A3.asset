  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A2_to_A3
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A2_Start
  toScene: A3_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Bohaterowie czuli ogromn\u0105 ulg\u0119 - prezydent wyspy okaza\u0142
      si\u0119 w porz\u0105dku i ich nie wyda\u0142!"
    seconds: 6.2
    voice: {fileID: 8300000, guid: b338afbfb1be1b0449641a04203b047f, type: 3}
  - text: "Ale najwi\u0119ksz\u0105 ekscytacja budzi\u0142 fakt, \u017Ce w ko\u0144cu
      namierzyli g\u0142\xF3wnego z\u0142oczy\u0144c\u0119."
    seconds: 5.5
    voice: {fileID: 8300000, guid: 06edfe737b2eba548abd675995c025d3, type: 3}
  - text: "Wiedzieli, gdzie przebywa, i czuli, \u017Ce ju\u017C za chwil\u0119 odbior\u0105
      mu ten tajemniczy przedmiot."
    seconds: 5.5
    voice: {fileID: 8300000, guid: d34cc59d03a2aaa4ba40d44b5ac49edd, type: 3}
  - text: Czekali na ten moment od dawna.
    seconds: 2.2
    voice: {fileID: 8300000, guid: 008a0ed9f5a0307419a65af004969181, type: 3}
