  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A3_to_A4
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A3_Start
  toScene: A4_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Akcja by\u0142a szalona, ale nie posz\u0142a zgodnie z planem."
    seconds: 3.3
    voice: {fileID: 8300000, guid: 36da5920ea187bb4481a7a9224b6fdfd, type: 3}
  - text: "Tajemniczego przedmiotu nie uda\u0142o si\u0119 ukra\u015B\u0107, lecz
      przynajmniej odzyskali swoj\u0105 bro\u0144!"
    seconds: 5.7
    voice: {fileID: 8300000, guid: 12d33b3690118434b940c6e8559a3a1e, type: 3}
  - text: "Wr\xF3g na pewno uciek\u0142, ale kto\u015B wpad\u0142 na pomys\u0142:
      wracamy na wysp\u0119."
    seconds: 4.9
    voice: {fileID: 8300000, guid: 575b21eef81935a43a9082eb0d2e4df9, type: 3}
  - text: "Poprzedni\u0105 rozmow\u0119 przerwa\u0142a policja, wi\u0119c mo\u017Ce
      prezydent wie o naszym celu co\u015B wi\u0119cej?"
    seconds: 5.2
    voice: {fileID: 8300000, guid: 329c37d07893fd34a9078122262c1760, type: 3}
  - text: "Z now\u0105 nadziej\u0105 ruszyli w drog\u0119 powrotn\u0105."
    seconds: 2.8
    voice: {fileID: 8300000, guid: 34c113e84c7ce24499666c32554f2cd1, type: 3}
