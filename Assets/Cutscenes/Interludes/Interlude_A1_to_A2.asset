MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A1_to_A2
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A1_Start
  toScene: A2_Start
  speaker: Narrator
  title: Tajemnicza wyspa
  pause: 0.5
  lines:
  - text: "Gdzie\u015B w bezpiecznej kryj\xF3wce, gdy syreny \u015Bcigaj\u0105cych
      ich str\xF3\u017C\xF3w prawa w ko\u0144cu ucich\u0142y, nasi bohaterowie z\u0142apali
      oddech."
    seconds: 8.2
    voice: {fileID: 8300000, guid: d987c6603c6a6d74b99a9194eacfb308, type: 3}
  - text: "Plan by\u0142 prosty: dopa\u015B\u0107 go, odebra\u0107 tajemniczy przedmiot
      i dowiedzie\u0107 si\u0119, czym w\u0142a\u015Bciwie jest."
    seconds: 7
    voice: {fileID: 8300000, guid: af6deaf9810a4584eb7285633f8f37c7, type: 3}
  - text: "Wiedzieli, \u017Ce policja nie odpu\u015Bci."
    seconds: 2.2
    voice: {fileID: 8300000, guid: 0bfce0773df906944a19393499116c09, type: 3}
  - text: "Uciekali tak d\u0142ugo, a\u017C trafili na ma\u0142\u0105, odci\u0119t\u0105
      od \u015Bwiata wysp\u0119."
    seconds: 4.5
    voice: {fileID: 8300000, guid: 6c18eb364286b2c42a3b942abe04f23c, type: 3}
  - text: "To tam postanowili obmy\u015Bli\u0107 kolejny krok."
    seconds: 2.7
    voice: {fileID: 8300000, guid: 8e7b0265a510abf42960f84ab58bca7c, type: 3}
