  m_Script: {fileID: 11500000, guid: 4a25e55f53eac1d45901ccec0e311b42, type: 3}
  m_Name: Interlude_A4_to_A5
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.StoryInterlude
  fromScene: A4_Start
  toScene: A5_Start
  speaker: Narrator
  title: 
  pause: 0.5
  lines:
  - text: "Czas sp\u0142aci\u0107 d\u0142ugi!"
    seconds: 1.7
    voice: {fileID: 8300000, guid: 650fbde19696e05418fa33d8ffa73c9f, type: 3}
  - text: "Skoro prezydent ich os\u0142oni\u0142, bohaterowie od razu ruszyli do
      pomocy na jego wielkim statku."
    seconds: 5.1
    voice: {fileID: 8300000, guid: 5619b766240839947affce5d118ac4e8, type: 3}
  - text: "Wspinaj\u0105c si\u0119 po stalowych pok\u0142adach, my\u015Bleli tylko
      o jednym \u2013 o sprytnym planie, kt\xF3ry uknuli ich opiekunowie."
    seconds: 7.6
    voice: {fileID: 8300000, guid: d1ea83241a27f9241960fe07d2c93f2d, type: 3}
  - text: "Wszystko musia\u0142o zagra\u0107 idealnie."
    seconds: 2.2
    voice: {fileID: 8300000, guid: a4627670d3d860e43ae94e6e19208ccb, type: 3}
