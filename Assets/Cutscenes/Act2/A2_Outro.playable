  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Opiekun 1
  text: "(szeptem) Ciii... Nie ruszajcie si\u0119."
  speakerColor: {r: 0.45, g: 0.75, b: 1, a: 1}
--- !u!114 &-5531211547661993527
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c129214db42c734da4ca27044da2477, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Prezydent wyspy
  text: "Oczywi\u015Bcie, panie w\u0142adzo."
  speakerColor: {r: 0.55, g: 0.95, b: 0.55, a: 1}
--- !u!114 &-4818039088342602634
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c129214db42c734da4ca27044da2477, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Prezydent wyspy
  text: "Nie wiem, jak wam dzi\u0119kowa\u0107. Uratowali\u015Bcie moj\u0105 wysp\u0119."
  speakerColor: {r: 0.55, g: 0.95, b: 0.55, a: 1}
--- !u!114 &-4530529675666327928
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c129214db42c734da4ca27044da2477, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Prezydent wyspy
  text: "Moi ludzie go wytropili. Ukrywa si\u0119 w jaskini niedaleko st\u0105d."
  speakerColor: {r: 0.55, g: 0.95, b: 0.55, a: 1}
--- !u!114 &-4191974864713681480
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
