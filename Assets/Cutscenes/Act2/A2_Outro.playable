  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::CoopGame.DialogueClip
  speaker: Prezydent wyspy
  text: "Nigdy nie widzia\u0142em nikogo takiego. Na mojej wyspie jest spokojnie."
  speakerColor: {r: 0.55, g: 0.95, b: 0.55, a: 1}
--- !u!114 &-6007496242581571865
MonoBehaviour:
  m_ObjectHideFlags: 1
